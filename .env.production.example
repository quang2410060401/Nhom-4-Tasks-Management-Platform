BE_PORT=6868
FE_PORT=5173

NODE_ENV=production
APP_BASE_URL=https://tasks.websm.net
FRONTEND_URL=https://tasks.websm.net
FRONTEND_URLS=https://tasks.websm.net
ALLOW_VERCEL_PREVIEW_ORIGINS=false
SWAGGER_ENABLED=false
ENABLE_INTERNAL_CRON=true
CRON_SECRET=change-this-long-random-cron-secret

MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=change-this-strong-mongodb-password
MONGODB_KEYFILE_CONTENT=change-this-long-random-mongodb-keyfile-content
MONGODB_URI=mongodb://root:change-this-strong-mongodb-password@mongo:27017/tasks?authSource=admin&replicaSet=rs0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=15000

JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=3600s

FILE_STORAGE_DRIVER=local
BLOB_ACCESS=public
BLOB_READ_WRITE_TOKEN=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM_NAME=Tasks Management Platform
SMTP_FROM_EMAIL=your-email@example.com

VITE_API_BASE_URL=/api
VITE_APP_NAME=Tasks Management Platform

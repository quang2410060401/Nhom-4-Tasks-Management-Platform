# Backend

# App
NODE_ENV=development
PORT=6868
APP_BASE_URL=http://localhost:6868
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
ALLOW_VERCEL_PREVIEW_ORIGINS=false
SWAGGER_ENABLED=true
ENABLE_INTERNAL_CRON=true

# MongoDB
# use docker mongodb from this repo
MONGODB_URI=mongodb://root:SecurePassw0rd2024!Mongo@127.0.0.1:27018/tasks?authSource=admin&replicaSet=rs0&directConnection=true

# use local mongodb service
#MONGODB_URI=mongodb://127.0.0.1:27017/tasks?replicaSet=rs0

# Production example (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://db-user:change-me@cluster-name.mongodb.net/tasks?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRES_IN=3600s

# Internal scheduler / GitHub Actions
CRON_SECRET=change-me-to-a-strong-cron-secret

# Firebase Admin (optional)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# File storage
FILE_STORAGE_DRIVER=local # Vercel storage Blob 
BLOB_ACCESS=public # For Vercel Blob Storage, set the following environment variable
BLOB_READ_WRITE_TOKEN= # For Vercel Blob Storage, set the following environment variable

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM_NAME=Tasks Management Platform
SMTP_FROM_EMAIL=your-email@example.com
